# Copy to frontend/.env.e2e and fill. This file is gitignored.
E2E_BASE_URL=http://127.0.0.1:4173
E2E_ROLE=admin
E2E_EMAIL=
E2E_PASSWORD=

# Agent-only pages need a separate active agent login.
E2E_AGENT_EMAIL=
E2E_AGENT_PASSWORD=

# Client Dashboard needs a client-role login.
E2E_CLIENT_EMAIL=
E2E_CLIENT_PASSWORD=

# Leave IDs blank to test the first row in each list.
# The save tests perform no value changes, but they still write the
# record and rebuild its schedule, so use disposable loans.
E2E_WEEKLY_ID=
E2E_MONTHLY_ID=
E2E_ALLOW_SAVE=0

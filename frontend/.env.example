# Supabase Configuration
VITE_SUPABASE_URL=your-project-url
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# Optional stateless API (Express) — offline sync + short-lived app JWTs
# ---------------------------------------------------------------------------
# Leave empty to run in Supabase-only mode. When set, the browser exchanges its
# Supabase session for an app JWT pair and uses this API for offline replay.
# The API serves routes under /api, so point this at the origin only:
#   VITE_API_URL=https://api.example.com
# For the bundled compose stack:
#   VITE_API_URL=http://localhost:4000
# VITE_API_URL=

# ---------------------------------------------------------------------------
# Email-bound RBAC (see docs/ARCHITECTURE.md)
# ---------------------------------------------------------------------------
# Comma-separated, lower-case, verified login emails.
# VITE_ADMIN_EMAILS=owner@example.com,finance@example.com
# VITE_AGENT_EMAILS=agent.one@example.com,agent.two@example.com

# Optional: every email on this domain resolves to the admin role.
# VITE_ADMIN_EMAIL_DOMAINS=example.com

# When true, accounts without a server role or an email binding get no frontend
# role and are signed out. Enable only after the role_bindings table is
# populated, otherwise staff cannot reach their portals.
# VITE_RBAC_STRICT=false

# Optional: Enable debug logging
# VITE_DEBUG=true

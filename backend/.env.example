# ---------------------------------------------------------------------------
# Finance Suite API
# ---------------------------------------------------------------------------
# The API is stateless: it issues short-lived access tokens and rotating
# refresh tokens. No session table is required, so any number of API nodes can
# serve the same user behind a load balancer.

NODE_ENV=development
PORT=4000
TRUST_PROXY=1

# Comma-separated browser origins allowed to call this API. Never use "*"
# together with credentials in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Supabase project used to verify the user's existing Supabase session.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Optional service role key. Only needed for server-side maintenance jobs.
# Never expose this value to the browser.
# SUPABASE_SERVICE_ROLE_KEY=

# JWT signing material. Use two different 32+ character random strings.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
JWT_ISSUER=finance-suite
JWT_AUDIENCE=finance-suite-web
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Offline sync limits
SYNC_MAX_BATCH=100
